[Unit]
Description=DropTouch receiver (phone ⇄ desktop file drops)
Documentation=file://%h/.local/share/droptouch/README.md
# needs the graphical session: D-Bus overlay, drop zone windows, notifications
PartOf=graphical-session.target
After=graphical-session.target network-online.target

[Service]
# save_dir and other settings come from ~/.config/droptouch/config.toml
ExecStart=%h/.local/share/droptouch/.venv/bin/python %h/.local/share/droptouch/receiver.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
